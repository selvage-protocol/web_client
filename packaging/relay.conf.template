# The origin relay, written at startup by `docker-entrypoint.d/40-selvage-relay.sh`
# from `SELVAGE_SERVER`: the page's own origin is then the room's server, so
# `/session` and `/meta` are proxied there and everything else, the page included,
# is served from this image. With no server configured the file is empty and
# `default.conf`'s include adds nothing.
#
# Both locations inherit the server block's `add_header` lines rather than declaring
# their own, which is what nginx does when a location adds no header: a relayed
# response carries the policy the path's name has (so a relayed `/meta` is
# `no-cache`, which is what an advisory read on every page load wants), `no-referrer`,
# `nosniff` and the page's policy. `selvaged`'s own `/meta` sends none of those four;
# on a JSON read they cost nothing, and one origin with one policy is the point of
# this image rather than a difference to preserve.

# `/session` is a WebSocket, so the two upgrade headers are what make nginx a byte
# pump; without them the 101 never reaches the guest and the session dies at the
# handshake. The read and send timeouts sit above the server's own ping, so they
# only fire on a socket that is genuinely gone.
#
# `Host` is the upstream's own name and port, exactly as `proxy_pass` names them and
# never the page's: a server behind anything that routes by name — the project's own
# front answers `444` to a name that is not its own — would refuse every request
# carrying the origin the page happens to be served under.
location = /session {
    proxy_pass __UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $proxy_host;

    # For an `https://` base: the upstream's name goes out as SNI and its certificate
    # is verified against the image's own CA bundle, which the base image carries at
    # that path. Written for an `http://` base too, where they apply to nothing, so
    # that one template renders both and no scheme branch can leave the verification
    # out.
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# One small JSON read on every page load, so it needs neither the upgrade nor a
# long-lived timeout.
location = /meta {
    proxy_pass __UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;

    # The same TLS handling as `/session` above.
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
}
