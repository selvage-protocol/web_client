{
  "name": "selvage-web-client",
  "version": "0.6.3",
  "private": true,
  "description": "Browser editor client for the Selvage session protocol (Monaco + shared sync engine)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selvage-protocol/web_client.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "sync-engine": "scripts/sync-engine.sh",
    "test": "node --test test/",
    "test:ci": "node scripts/test-ci.mjs",
    "prove": "node scripts/prove-m1.mjs",
    "prove:v2": "node scripts/prove-v2.mjs",
    "prove:fb2": "node scripts/prove-fb2.mjs",
    "prove:tls": "node scripts/prove-tls.mjs",
    "prove:flow2": "node scripts/prove-flow2.mjs",
    "prove:ghost": "node scripts/prove-ghost.mjs",
    "check:types": "node scripts/check-content-types.mjs",
    "serve": "python3 -m http.server 8081 --directory dist"
  },
  "dependencies": {
    "lib0": "0.2.119",
    "monaco-editor": "0.57.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
